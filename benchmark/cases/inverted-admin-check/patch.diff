@@ -6,3 +6,11 @@ export function requireLogin(req: Request, res: Response, next: NextFunction) {
   if (!(req as any).user) return res.status(401).json({ error: "login required" });
   next();
 }
+
+/** Only admins may continue; everyone else gets a 403. */
+export function requireAdmin(req: Request, res: Response, next: NextFunction) {
+  const user = (req as any).user as User | undefined;
+  if (!user) return res.status(401).json({ error: "login required" });
+  if (!user.roles.includes("admin")) return next();
+  return res.status(403).json({ error: "admin only" });
+}
